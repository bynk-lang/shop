suite shop.orders
-- The order's state machine, driven directly. The `api` service coordinates
-- the other contexts around it; that flow is covered by e2e/scenarios.sh.

case "a new order is pending" {
	let v <- Order("o1").view()
	expect v.status == "pending"
}

case "opening an order records it and moves it to opened" {
	let r <- Order("o2").open("alice", "widget", 3, 2500)
	expect r is Ok(_)
	let v <- Order("o2").view()
	expect v.status == "opened"
	expect v.owner == "alice"
	expect v.qty == 3
	expect v.cents == 2500
}

case "an order is decided once: opening it again is refused" {
	let _ <- Order("o3").open("alice", "widget", 3, 2500)
	let again <- Order("o3").open("bob", "gadget", 1, 100)
	expect again is Err(_)
	let v <- Order("o3").view()
	expect v.owner == "alice"
}

case "a confirmed order is placed, and can be cancelled once" {
	let _ <- Order("o4").open("alice", "widget", 3, 2500)
	let _ <- Order("o4").confirm()
	let placed <- Order("o4").view()
	expect placed.status == "placed"
	let first <- Order("o4").cancel()
	expect first is Ok(_)
	let second <- Order("o4").cancel()
	expect second is Err(_)
}

case "a rejected order cannot be cancelled" {
	let _ <- Order("o5").open("alice", "widget", 3, 2500)
	let _ <- Order("o5").reject()
	let r <- Order("o5").cancel()
	expect r is Err(_)
	let v <- Order("o5").view()
	expect v.status == "rejected"
}

case "an order that was never placed cannot be cancelled" {
	let r <- Order("o6").cancel()
	expect r is Err(_)
}
