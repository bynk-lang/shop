suite shop.inventory

case "stock starts at zero and restocking adds to it" {
	let before <- Inventory(skuFrom("w1")).level()
	expect before == 0
	let after <- Inventory(skuFrom("w1")).restock(10)
	expect after == 10
}

case "a reservation holds stock for its order, a release puts it back" {
	let _ <- Inventory(skuFrom("w2")).restock(10)
	let held <- Inventory(skuFrom("w2")).reserve(orderIdFrom("o1"), 3)
	expect held is Ok(_)
	let mid <- Inventory(skuFrom("w2")).level()
	expect mid == 7
	let holding <- Inventory(skuFrom("w2")).held()
	expect holding == 3
	let back <- Inventory(skuFrom("w2")).release(orderIdFrom("o1"))
	expect back == 10
	let after <- Inventory(skuFrom("w2")).held()
	expect after == 0
}

case "reserving more than is available is refused and takes nothing" {
	let _ <- Inventory(skuFrom("w3")).restock(2)
	let held <- Inventory(skuFrom("w3")).reserve(orderIdFrom("o1"), 3)
	expect held is Err(_)
	let left <- Inventory(skuFrom("w3")).level()
	expect left == 2
	let holding <- Inventory(skuFrom("w3")).held()
	expect holding == 0
}

case "each sku has its own stock" {
	let _ <- Inventory(skuFrom("a")).restock(5)
	let other <- Inventory(skuFrom("b")).level()
	expect other == 0
}

case "reserving for the same order twice holds once" {
	let _ <- Inventory(skuFrom("w4")).restock(10)
	let _ <- Inventory(skuFrom("w4")).reserve(orderIdFrom("o1"), 3)
	let again <- Inventory(skuFrom("w4")).reserve(orderIdFrom("o1"), 3)
	expect again is Ok(_)
	let left <- Inventory(skuFrom("w4")).level()
	expect left == 7
}

case "a committed hold is sold: releasing it afterwards returns nothing" {
	let _ <- Inventory(skuFrom("w5")).restock(10)
	let _ <- Inventory(skuFrom("w5")).reserve(orderIdFrom("o1"), 3)
	let sold <- Inventory(skuFrom("w5")).commit(orderIdFrom("o1"))
	expect sold is Ok(_)
	let after <- Inventory(skuFrom("w5")).release(orderIdFrom("o1"))
	expect after == 7
	let holding <- Inventory(skuFrom("w5")).held()
	expect holding == 0
}

case "a hold that is gone cannot be committed" {
	let _ <- Inventory(skuFrom("w6")).restock(10)
	let _ <- Inventory(skuFrom("w6")).reserve(orderIdFrom("o1"), 3)
	let _ <- Inventory(skuFrom("w6")).release(orderIdFrom("o1"))
	let sold <- Inventory(skuFrom("w6")).commit(orderIdFrom("o1"))
	expect sold is Err(_)
	let never <- Inventory(skuFrom("w6")).commit(orderIdFrom("o2"))
	expect never is Err(_)
}

case "a release is idempotent" {
	let _ <- Inventory(skuFrom("w7")).restock(10)
	let _ <- Inventory(skuFrom("w7")).reserve(orderIdFrom("o1"), 3)
	let first <- Inventory(skuFrom("w7")).release(orderIdFrom("o1"))
	expect first == 10
	let second <- Inventory(skuFrom("w7")).release(orderIdFrom("o1"))
	expect second == 10
}

case "releaseStale returns the holds made before the cutoff, and only those" {
	stub Clock.now() returns each [Instant.fromEpochMillis(1000), Instant.fromEpochMillis(5000)]
	let _ <- Inventory(skuFrom("w8")).restock(10)
	let _ <- Inventory(skuFrom("w8")).reserve(orderIdFrom("old"), 2)
	let _ <- Inventory(skuFrom("w8")).reserve(orderIdFrom("new"), 3)
	let units <- Inventory(skuFrom("w8")).releaseStale(Instant.fromEpochMillis(3000))
	expect units == 2
	let left <- Inventory(skuFrom("w8")).level()
	expect left == 7
	let holding <- Inventory(skuFrom("w8")).held()
	expect holding == 3
	let sold <- Inventory(skuFrom("w8")).commit(orderIdFrom("new"))
	expect sold is Ok(_)
	let gone <- Inventory(skuFrom("w8")).commit(orderIdFrom("old"))
	expect gone is Err(_)
}

case "restocking registers the sku in the catalogue, once" {
	let _ <- restock.call(skuFrom("w9"), 5) by Caller("shop.orders")
	let _ <- restock.call(skuFrom("w9"), 5) by Caller("shop.orders")
	let _ <- restock.call(skuFrom("w10"), 1) by Caller("shop.orders")
	let skus <- Catalogue("all").all()
	expect skus.count() == 2
	expect skus.any((s) => s == skuFrom("w9"))
}

case "the sweeper releases a hold older than fifteen minutes" {
	// The hold is made at the epoch; the run is scheduled sixteen minutes on.
	let _ <- restock.call(skuFrom("w11"), 10) by Caller("shop.orders")
	let _ <- reserve.call(skuFrom("w11"), orderIdFrom("o1"), 4) by Caller("shop.orders")
	let r <- sweeper.schedule("*/5 * * * *", 960000)
	expect r is Ok(_)
	let left <- level.call(skuFrom("w11")) by Caller("shop.orders")
	expect left == 10
	expect Logger.info called once with msg == "released 4 units from stale holds"
}

case "the sweeper leaves a fresh hold, and a sold one, alone" {
	let _ <- restock.call(skuFrom("w12"), 10) by Caller("shop.orders")
	let _ <- reserve.call(skuFrom("w12"), orderIdFrom("fresh"), 2) by Caller("shop.orders")
	let _ <- reserve.call(skuFrom("w12"), orderIdFrom("sold"), 3) by Caller("shop.orders")
	let _ <- commit.call(skuFrom("w12"), orderIdFrom("sold")) by Caller("shop.orders")
	// Fourteen minutes on: "fresh" is not yet stale, "sold" holds nothing.
	let r <- sweeper.schedule("*/5 * * * *", 840000)
	expect r is Ok(_)
	let left <- level.call(skuFrom("w12")) by Caller("shop.orders")
	expect left == 5
	expect Logger.info never called
}

case "a delivery from the queue is stocked, and the sweeper can find it" {
	let r <- deliveries.message(Delivery { id: "d1", sku: skuFrom("w13"), qty: 6 })
	expect r is Ack
	let left <- Inventory(skuFrom("w13")).level()
	expect left == 6
	let skus <- Catalogue("all").all()
	expect skus.any((s) => s == skuFrom("w13"))
}

case "a delivery that arrives twice is stocked once" {
	let d = Delivery {
		id: "d2",
		sku: skuFrom("w14"),
		qty: 6,
	}
	let _ <- deliveries.message(d)
	let _ <- deliveries.message(d)
	let left <- Inventory(skuFrom("w14")).level()
	expect left == 6
}
