context shop.ledger

uses shop.values
consumes shop.orders
consumes bynk { Claim, Idempotency }

type StaffId = String where NonEmpty

actor Staff { auth = Bearer(secret = "AUTH_JWT_SECRET"), identity = StaffId }

actor Admin = Staff where hasClaim("admin")

type Totals = {
	orders: Int,
	units: Int,
	cents: Int,
}

---
The books: how many orders are standing, and for how much. One instance, since
the totals are one number each.

Events are delivered at least once, so each handler claims its event id with
`Idempotency` before it counts the event, and a repeat delivery is ignored. The
claim lasts seven days and is released if the handler fails, so a retry is
still counted. An event carries the unit price, so the amount an order adds to
the books is `qty * cents`.
---
agent Books {
	key id: String

	store orders: Cell[Int]
	store units: Cell[Int]
	store cents: Cell[Int]

	on call placed(qty: Int, amount: Int) -> Effect[()] {
		let _ <- orders.update((v) => v + 1)
		let _ <- units.update((v) => v + qty)
		let _ <- cents.update((v) => v + amount)
	}

	on call cancelled(qty: Int, amount: Int) -> Effect[()] {
		let _ <- orders.update((v) => v - 1)
		let _ <- units.update((v) => v - qty)
		let _ <- cents.update((v) => v - amount)
	}

	on call totals() -> Effect[Totals] {
		Totals {
			orders: orders,
			units: units,
			cents: cents,
		}
	}
}

service OnPlaced from Events(OrderPlaced) {
	on event(e: OrderPlaced, env: EventEnvelope) -> Effect[()] given Idempotency {
		let Claim.Claimed <- Idempotency.claim(env.eventId, 7.days) else { () }
		let _ <- Books("main").placed(e.qty, e.qty * e.cents)
	}
}

service OnCancelled from Events(OrderCancelled) {
	on event(e: OrderCancelled, env: EventEnvelope) -> Effect[()] given Idempotency {
		let Claim.Claimed <- Idempotency.claim(env.eventId, 7.days) else { () }
		let _ <- Books("main").cancelled(e.qty, e.qty * e.cents)
	}
}

service api from http {
	on GET("/totals") () -> Effect[HttpResult[Totals]] by a: Admin {
		let t <- Books("main").totals()
		Ok(t)
	}
}
