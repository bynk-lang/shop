context shop.orders

uses shop.values
consumes shop.inventory as Stock
consumes shop.payments as Pay
consumes bynk { Events, Logger }
exports transparent { OrderPlaced, OrderCancelled }

---
Who is asking: the `sub` of a verified bearer token.
---
type CustomerId = String where NonEmpty

actor Customer { auth = Bearer(secret = "AUTH_JWT_SECRET"), identity = CustomerId }

---
A customer whose token also carries the `admin` claim. Not logged in is
`401`; logged in but not an admin is `403`.
---
actor Admin = Customer where hasClaim("admin")

---
Facts other contexts can react to. The ledger subscribes; orders neither knows
nor cares who listens.
---
event OrderPlaced = { orderId: OrderId, sku: Sku, qty: Quantity, cents: Cents }

event OrderCancelled = { orderId: OrderId, sku: Sku, qty: Quantity, cents: Cents }

---
Where an order is in its life. A new order is `Pending`; `open` moves it to
`Opened` while the stock and the payment are being settled, and exactly one of
`confirm` or `reject` then decides it. Only a `Placed` order can be cancelled.
---
type Status = enum { Pending, Opened, Placed, Rejected, Cancelled }

---
Why a placement or cancellation was refused. `TooLarge` carries the reason
the order's total isn't a price the shop can charge; `embeds` lets `?` turn
that `ValidationError` into an `OrderError`.
---
type OrderError = | TooLarge(reason: ValidationError)
| OutOfStock
| PaymentDeclined
| AlreadyDecided
| NotPlaced
embeds ValidationError as TooLarge

---
What the customer is buying: one sku, how many, and the price they agreed.
Every field is checked when the request body is read, so a zero quantity or
an empty sku is a `400` before any handler runs.
---
type OrderLine = { sku: Sku, qty: Quantity, cents: Cents }

---
What the order comes to. The total must itself be a `Cents`, so an order over
100,000.00 is refused before any stock is reserved or card charged.
---
fn total(line: OrderLine) -> Result[Cents, OrderError] { Ok(Cents.of(line.qty * line.cents)?) }

---
An order as its agent holds it. `line` is `None` until the order is opened.
---
type Snapshot = { status: Status, owner: String, line: Option[OrderLine] }

---
One order, keyed by the id the customer chose, so placing the same id twice
cannot place it twice. The agent owns the order's state and the rules for
moving it; it calls no other context. Rejected and cancelled are final: the
two transitions refuse any commit that would move an order out of either.
The `api` service below coordinates the inventory, the payment and the
events, because those are cross-context calls.
---
agent Order {
	key id: OrderId

	store status: Cell[Status] = Pending
	store owner: Cell[String]
	store line: Cell[Option[OrderLine]]

	transition rejected_is_final:
		old.status is Rejected implies new.status is Rejected

	transition cancelled_is_final:
		old.status is Cancelled implies new.status is Cancelled

	on call open(who: String, wanted: OrderLine) -> Effect[Result[(), OrderError]] {
		match status {
			Pending => {
				owner := who
				line := Some(wanted)
				status := Opened
				Ok(())
			},
			_ => Err(AlreadyDecided),
		}
	}

	on call confirm() -> Effect[()] {
		status := Placed
	}

	on call reject() -> Effect[()] {
		status := Rejected
	}

	on call cancel() -> Effect[Result[(), OrderError]] {
		match status {
			Placed => {
				status := Cancelled
				Ok(())
			},
			_ => Err(NotPlaced),
		}
	}

	on call view() -> Effect[Snapshot] { Snapshot { status: status, owner: owner, line: line } }
}

type OrderView = {
	id: OrderId,
	status: String,
	owner: String,
	sku: Sku,
	qty: Quantity,
	cents: Cents,
}

type StockRequest = { qty: Quantity }

---
Whether a product can be ordered. A visitor sees only `InStock` or
`SoldOut`; a signed-in customer sees how many are left.
---
type Availability = | InStock
| SoldOut
| Left(count: Int)

fn name(s: Status) -> String {
	match s {
		Pending => "pending",
		Opened => "opened",
		Placed => "placed",
		Rejected => "rejected",
		Cancelled => "cancelled",
	}
}

---
The customer's view of an order: `None` for an order that was never opened,
or that belongs to someone else, so neither can be told from the other.
---
fn shown(id: OrderId, o: Snapshot, who: String) -> Option[OrderView] {
	match o.line {
		None => None,
		Some(l) => if o.owner == who {
			Some(OrderView {
				id: id,
				status: name(o.status),
				owner: o.owner,
				sku: l.sku,
				qty: l.qty,
				cents: l.cents,
			})
		} else {
			None
		},
	}
}

service api from http {
	on PUT("/orders/:id") (
		id: OrderId,
		body: OrderLine
	) -> Effect[HttpResult[OrderView]] by c: Customer given Events, Logger {
		match total(body) {
			Err(_) => UnprocessableEntity("the order comes to more than 100,000.00"),
			Ok(t) => {
				let opened <- Order(id).open(c.identity, body)
				match opened {
					Err(_) => Conflict("order already decided"),
					Ok(_) => {
						let held <- Stock.reserve(body.sku, id, body.qty)
						match held {
							Err(_) => {
								let _ <- Order(id).reject()
								Conflict("out of stock")
							},
							Ok(_) => {
								let paid <- Pay.authorise(id, body.cents)
								match paid {
									Err(why) => {
										let _ <- Stock.release(body.sku, id)
										let _ <- Order(id).reject()
										match why {
											Declined => UnprocessableEntity("payment declined"),
											Unavailable => ServiceUnavailable(
												"payment unavailable"
											),
										}
									},
									Ok(_) => {
										-- `Err` means the sweeper released the hold while the payment
										-- was being taken. The stock may already be someone else's, so
										-- the order cannot stand. The authorisation should be voided
										-- too; `Gateway` has no void yet, so for now it is not.
										let sold <- Stock.commit(body.sku, id)
										match sold {
											Err(_) => {
												let _ <- Order(id).reject()
												Conflict("reservation expired")
											},
											Ok(_) => {
												let _ <- Order(id).confirm()
												let _ <- Events.emit[OrderPlaced](OrderPlaced {
													orderId: id,
													sku: body.sku,
													qty: body.qty,
													cents: body.cents,
												})
												~> Logger.info("placed order for \(t) cents")
												Created(OrderView {
													id: id,
													status: "placed",
													owner: c.identity,
													sku: body.sku,
													qty: body.qty,
													cents: body.cents,
												})
											},
										}
									},
								}
							},
						}
					},
				}
			},
		}
	}

	on GET("/orders/:id") (id: OrderId) -> Effect[HttpResult[OrderView]] by c: Customer {
		let o <- Order(id).view()
		match shown(id, o, c.identity) {
			None => NotFound,
			Some(v) => Ok(v),
		}
	}

	on POST("/orders/:id/cancel") (
		id: OrderId
	) -> Effect[HttpResult[OrderView]] by c: Customer given Events {
		let o <- Order(id).view()
		match shown(id, o, c.identity) {
			None => NotFound,
			Some(v) => {
				let r <- Order(id).cancel()
				match r {
					Err(_) => Conflict("only a placed order can be cancelled"),
					Ok(_) => {
						let _ <- Stock.restock(v.sku, v.qty)
						let _ <- Events.emit[OrderCancelled](OrderCancelled {
							orderId: id,
							sku: v.sku,
							qty: v.qty,
							cents: v.cents,
						})
						Ok(OrderView {
							id: id,
							status: "cancelled",
							owner: v.owner,
							sku: v.sku,
							qty: v.qty,
							cents: v.cents,
						})
					},
				}
			},
		}
	}

	on PUT("/stock/:sku") (sku: Sku, body: StockRequest) -> Effect[HttpResult[Int]] by a: Admin {
		let level <- Stock.restock(sku, body.qty)
		Ok(level)
	}

	on GET("/stock/:sku") (
		sku: Sku
	) -> Effect[HttpResult[Availability]] by who: Customer | Visitor {
		let level <- Stock.level(sku)
		match who {
			Customer(_) => Ok(Left(level)),
			Visitor => if level > 0 { Ok(InStock) } else { Ok(SoldOut) },
		}
	}
}
